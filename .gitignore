# Keep the Gradle Wrapper jar even though *.jar is ignored above.
# Without this line, `gradle/wrapper/gradle-wrapper.jar` gets excluded from
# version control and `./gradlew` fails with:
# "Could not find or load main class org.gradle.wrapper.GradleWrapperMain"
!gradle/wrapper/gradle-wrapper.jar

